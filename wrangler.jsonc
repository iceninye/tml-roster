{
  "name": "tml-roster",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": false
  },
  // 跨裝置同步用。正式 id 要喺 Cloudflare dashboard 開個 KV namespace 之後貼落嚟：
  //   wrangler kv namespace create ROSTER_KV      (或用 dashboard → Workers & Pages → KV)
  "kv_namespaces": [
    { "binding": "ROSTER_KV", "id": "e9aeed4e52d54d30a36c68b068789c1b" }
  ],
  // 電郵（編更備份、token log、上傳覆蓋前嘅雲端備份）用兩個 secret，唔好寫喺呢度：
  //   wrangler secret put RESEND_API_KEY   (Resend 帳戶嘅 API key)
  //   wrangler secret put BACKUP_TO        (收件人電郵)
  "previews": {}
}
