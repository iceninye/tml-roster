{
  "name": "tml-roster",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // 部署時唔好洗走 dashboard 設嘅 variables／secrets（RESEND_API_KEY、BACKUP_TO）。
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": false
  },
  // 跨裝置同步用。正式 id 要喺 Cloudflare dashboard 開個 KV namespace 之後貼落嚟：
  //   wrangler kv namespace create ROSTER_KV      (或用 dashboard → Workers & Pages → KV)
  "kv_namespaces": [
    { "binding": "ROSTER_KV", "id": "e9aeed4e52d54d30a36c68b068789c1b" }
  ],
  // 電郵（編更備份、token log、上傳覆蓋前嘅雲端備份）用兩個 secret，唔好寫喺呢度：
  //   wrangler secret put RESEND_API_KEY   (Resend 帳戶嘅 API key)
  //   wrangler secret put BACKUP_TO        (收件人電郵)
  // /api/backup 同 /api/token-log 按 IP 限速：每分鐘最多 5 次（Workers Rate Limiting binding，
  // 唔使喺 dashboard 設；namespace_id 係自己揀嘅數字，帳戶內唔好同第個 limiter 撞）。
  "ratelimits": [
    { "name": "MAIL_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "previews": {}
}
